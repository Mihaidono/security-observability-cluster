{
  "project_name": "isolens",
  "environment": "lab",
  "region": "eu-north-1",
  "cluster_name": "forensic-lab",
  "kubernetes_version": "1.35",
  "enable_ingress_nginx": false,
  "control_plane_namespace": "isolens-system",
  "control_plane_namespace_labels": {},
  "control_plane_namespace_annotations": {},
  "control_plane_backend_image": "401262697743.dkr.ecr.eu-north-1.amazonaws.com/isolens-backend:latest",
  "control_plane_backend_image_pull_policy": "IfNotPresent",
  "control_plane_backend_replicas": 1,
  "control_plane_backend_service_name": "isolens-backend",
  "control_plane_backend_service_port": 8000,
  "control_plane_backend_container_port": 8000,
  "control_plane_backend_resources": {
    "requests_cpu": "250m",
    "requests_memory": "512Mi",
    "limits_cpu": "1000m",
    "limits_memory": "1Gi"
  },
  "control_plane_frontend_image": "401262697743.dkr.ecr.eu-north-1.amazonaws.com/isolens-frontend:latest",
  "control_plane_frontend_image_pull_policy": "IfNotPresent",
  "control_plane_frontend_replicas": 1,
  "control_plane_frontend_service_name": "isolens-frontend",
  "control_plane_frontend_service_port": 80,
  "control_plane_frontend_container_port": 8080,
  "control_plane_frontend_resources": {
    "requests_cpu": "100m",
    "requests_memory": "128Mi",
    "limits_cpu": "500m",
    "limits_memory": "256Mi"
  },
  "control_plane_runner_name": "isolens-runner",
  "control_plane_runner_replicas": 1,
  "control_plane_runner_resources": {
    "requests_cpu": "250m",
    "requests_memory": "512Mi",
    "limits_cpu": "1000m",
    "limits_memory": "1Gi"
  },
  "control_plane_public_app_url": "http://localhost:5173",
  "control_plane_session_cookie_secure": true,
  "keycloak_name": "isolens-keycloak",
  "keycloak_image": "quay.io/keycloak/keycloak:26.6.4",
  "keycloak_image_pull_policy": "IfNotPresent",
  "keycloak_realm": "isolens",
  "keycloak_client_id": "isolens-web",
  "keycloak_client_secret": "",
  "keycloak_database_name": "keycloak",
  "keycloak_database_username": "keycloak",
  "postgresql_name": "isolens-postgresql",
  "postgresql_database_name": "isolens",
  "postgresql_username": "isolens",
  "postgresql_port": 5432,
  "postgresql_instance_class": "db.t3.medium",
  "postgresql_engine_version": null,
  "postgresql_allocated_storage": 20,
  "postgresql_max_allocated_storage": 100,
  "postgresql_storage_type": "gp3",
  "postgresql_backup_retention_period": 7,
  "postgresql_backup_window": "03:00-04:00",
  "postgresql_maintenance_window": "sun:04:30-sun:05:30",
  "postgresql_multi_az": true,
  "postgresql_deletion_protection": false,
  "postgresql_skip_final_snapshot": true,
  "postgresql_apply_immediately": true,
  "postgresql_storage_encrypted": true
}
