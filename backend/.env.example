AWS_PROFILE=your-sso-profile
AWS_SDK_LOAD_CONFIG=true
AWS_CONFIG_FILE=/root/.aws/config
AWS_SHARED_CREDENTIALS_FILE=/root/.aws/credentials
AWS_REGION=eu-north-1
AWS_DEFAULT_REGION=eu-north-1
TERRAFORM_BIN=terraform
ISOLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ISOLENS_DATABASE_URL=postgresql://isolens:isolens-dev-password-change-me@localhost:5432/isolens
ISOLENS_PUBLIC_APP_URL=http://localhost:5173
ISOLENS_OIDC_INTERNAL_BASE_URL=http://keycloak:8080/auth
ISOLENS_OIDC_REALM=isolens
ISOLENS_OIDC_CLIENT_ID=isolens-web
ISOLENS_OIDC_CLIENT_SECRET=
ISOLENS_SESSION_COOKIE_NAME=isolens_session
ISOLENS_SESSION_COOKIE_SECURE=false
ISOLENS_SESSION_TTL_SECONDS=28800
ISOLENS_WORKER_POLL_INTERVAL_SECONDS=2
ISOLENS_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
ISOLENS_WORKER_HEARTBEAT_TTL_SECONDS=20
